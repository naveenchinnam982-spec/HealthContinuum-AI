# ── HealthContinuum AI — Environment Variables ──────────────────────────────
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.

# ── Application ─────────────────────────────────────────────────────────────
APP_NAME=HealthContinuum AI
APP_ENV=development
DEBUG=true
SECRET_KEY=CHANGE_ME_USE_OPENSSL_RAND_HEX_32

# ── Database ─────────────────────────────────────────────────────────────────
# For local development we use SQLite (no server needed).
# For production, switch to PostgreSQL below.
DATABASE_URL=sqlite+aiosqlite:///./healthcontinuum.db

# PostgreSQL (production)
# DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/healthcontinuum

# ── Supabase (optional — for production) ────────────────────────────────────
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ── JWT Auth ─────────────────────────────────────────────────────────────────
JWT_SECRET_KEY=CHANGE_ME_JWT_SECRET
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60

# ── CORS ─────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed origins
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:5500,file://

# ── Doctor Access Codes ───────────────────────────────────────────────────────
ACCESS_CODE_EXPIRE_MINUTES=10

# ── Storage (future) ──────────────────────────────────────────────────────────
STORAGE_BACKEND=local
STORAGE_LOCAL_PATH=./uploads

# ── OpenRouter patient chat (optional) ───────────────────────────────────────
# Set the real key in Render Environment settings; never commit a real key.
OPENROUTER_API_KEY=
OPENROUTER_RECORD_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free
OPENROUTER_HEALTH_MODEL=inclusionai/ling-3.0-flash-sante:free
