rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Patient records are private by default. Authentication alone is NOT authorization.
    function isPatientOwner(patientId) {
      return request.auth != null
        && (
          request.auth.uid == patientId
          || patientId == 'pat-' + request.auth.uid
          || request.auth.token.patientId == patientId
        );
    }

    match /patients/{patientId} {
      allow read, create, update, delete: if isPatientOwner(patientId);

      match /visits/{visitId} {
        allow read, create, update, delete: if isPatientOwner(patientId);
      }

      match /medications/{medicationId} {
        allow read, create, update, delete: if isPatientOwner(patientId);
      }

      match /labs/{labId} {
        allow read, create, update, delete: if isPatientOwner(patientId);
      }

      match /documents/{docId} {
        allow read, create, update, delete: if isPatientOwner(patientId);
      }

      match /decisions/{decisionId} {
        allow read, create, update, delete: if isPatientOwner(patientId);
      }
    }

    // Access grants must be managed by a trusted backend with explicit patient
    // consent and audit logging; clients cannot mint or alter their own grants.
    match /access_grants/{grantId} {
      allow read, write: if false;
    }

    // Deny all collections not explicitly listed above.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
