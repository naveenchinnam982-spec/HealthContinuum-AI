rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    // Patient documents are keyed by the authenticated Firebase UID.
    // The optional patientId claim supports a future server-issued mapping.
    function ownsPatient(patientId) {
      return signedIn() && (
        request.auth.uid == patientId ||
        ('patientId' in request.auth.token &&
          request.auth.token.patientId == patientId)
      );
    }

    match /patients/{patientId} {
      allow get, list: if ownsPatient(patientId);
      allow create, update: if ownsPatient(patientId);
      allow delete: if false;

      // Clinical subcollections (visits, medications, labs, documents, etc.)
      // remain private to the owning patient.
      match /{subcollection}/{document=**} {
        allow read, create, update: if ownsPatient(patientId);
        allow delete: if false;
      }
    }

    // Do not allow browsers to read, create, or modify doctor access grants.
    // Grant issuance/redemption must be handled by a server that verifies identity,
    // patient ownership, scopes, expiry, and doctor authorization.
    match /access_grants/{grantId} {
      allow read, write: if false;
    }

    // Deny every collection not explicitly allowed above.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
